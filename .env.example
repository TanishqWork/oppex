# Copy this file to `.env` and fill in the value. `.env` is gitignored.
# Vite only reads .env at startup — restart `npm run dev` after editing.

# Where BOTH forms are sent: the waitlist ("Claim early Access") and the
# project posting form (/post-a-project).
#
# Today: a Google Apps Script web app that files each submission into the
# right tab of one Google Sheet — "Waitlist" or "Projects". Setup
# instructions are at the top of scripts/sheet-collector.gs.
#
#   VITE_WAITLIST_ENDPOINT="https://script.google.com/macros/s/AKfy.../exec"
#
# Later: point this at your own API instead. It receives a JSON POST of
#   { email, source, submittedAt, userAgent }
# for a waitlist signup, and the fuller project payload described below, so
# no frontend code needs to change.
#
# This value is NOT a secret — it ships in the client bundle. Anyone with the
# URL can append rows, so treat it as a public write endpoint.
VITE_WAITLIST_ENDPOINT=

# Optional. Leave BLANK for the normal setup.
#
# The project form falls back to VITE_WAITLIST_ENDPOINT, and
# scripts/sheet-collector.gs already routes those submissions to the
# "Projects" tab, so one URL covers both forms.
#
# Set this only if you want projects to go somewhere else entirely — a
# different sheet, a CRM, your own API. It receives a JSON POST of
#   { product, budget, timeline, title, description, email, phone,
#     source: "post-project", submittedAt, userAgent }
#
# Like the value above, this is NOT a secret — it ships in the client bundle.
VITE_PROJECT_ENDPOINT=
